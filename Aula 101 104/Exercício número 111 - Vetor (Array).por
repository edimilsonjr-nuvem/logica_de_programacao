programa {
  funcao inicio() {
    cadeia disciplinas[5]

    disciplinas[0] = "Matématica"
    disciplinas[1] = "Português"
    disciplinas[2] = "Quimica"
    disciplinas[3] = "Geografia"

    disciplinas[4] = "Historia"

    escreva("Primeira disciplina armazenada: ", disciplinas[0], "\n")
    escreva("Segunda disciplina armazenada: ", disciplinas[4])
  }
}
