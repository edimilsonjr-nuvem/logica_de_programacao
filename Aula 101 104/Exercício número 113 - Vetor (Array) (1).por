programa {
  funcao inicio() {
    inteiro numerosInteiros[5]

    escreva("indice 0: ")
    leia(numerosInteiros[0])
    escreva("indice 1: ")
    leia(numerosInteiros[1])
    escreva("indice 2: ")
    leia(numerosInteiros[2])

    numerosInteiros[3] = 50
    numerosInteiros[4] = 90

    escreva("\n", numerosInteiros)


    
  }
}
