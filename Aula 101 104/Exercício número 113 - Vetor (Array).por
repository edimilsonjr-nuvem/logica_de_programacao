programa {
  funcao inicio() {
    inteiro numerosInteiros[5]

    escreva("Digite o primeiro número: ")
    leia(numerosInteiros[0])
    escreva("Digite o segundo número: ")
    leia(numerosInteiros[1])
    escreva("Digite o terceiro número: ")
    leia(numerosInteiros[2])

    escreva("Digite os números restantes: ")
    leia(numerosInteiros[3])
    escreva("Digite os números restantes: ")
    leia(numerosInteiros[4])

    escreva("\n", numerosInteiros)


    
  }
}
